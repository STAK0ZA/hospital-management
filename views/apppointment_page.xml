<odoo>

    <record id="appointment_tree_view" model="ir.ui.view">
        <field name="name">appointment.tree</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <tree sample="1" multi_edit="1" decoration-success="state=='done'" decoration-danger="state=='cancel'"
                  decoration-info="state=='draft'" decoration-warning="state=='in_consultation'">
                <field name="patient_id" string="Patient Name"/>
                <field name="patient_gender" string="Patient Gender"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="date_day" string="Day Created"/>
                <field name="activity_ids" widget="list_activity"/>
                <field name="state" string="State" widget="badge"
                       decoration-success="state=='done'"
                       decoration-danger="state=='cancel'"
                       decoration-info="state=='draft'"
                       decoration-warning="state=='in_consultation'"
                />
                <field name="birth_day" string="Patient Birth" optional="hide"/>
                <field name="user_level" widget="many2many_tags" options="{'color_field':'color'}"/>
            </tree>
        </field>
    </record>

    <record id="appointment_form_view" model="ir.ui.view">
        <field name="name">hospital.appointment</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="draft_state" type="object" string="Draft" class="oe_highlight"
                            invisible="state != 'in_consultation'" data_hotkey="z"/>
                    <button name="in_consultation_state" type="object" string="In Consultation" class="oe_highlight"
                            invisible="state != 'draft'" data_hotkey="x"/>
                    <button name="done_state" type="object" string="Done" class="oe_highlight"
                            invisible="state != 'in_consultation'" data_hotkey="c"/>
                    <button name="cancel_state" type="object" string="Cancel" class="oe_highlight"
                            invisible="state != 'in_consultation'" data_hotkey="v"/>
<!--                    <button name="cancel_state" type="object" string="Cancel" class="oe_highlight"-->
<!--                            invisible="state != 'in_consultation'" data_hotkey="v"/>-->
                    <field name="state" widget="statusbar" nolabel="1" options="{'clickable':'1'}"
                           statusbar_visible="start,in_progress,draft,done,in_consultation"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="patient_id" string="Patient Name" help="User name"/>
                            <field name="user_id" widget="many2one_avatar" default_focus="1"/>
                            <field name="date_now" string="Time Created"/>
                            <field name="show_col" string="Show Column"/>
                        </group>
                        <group>
                            <field name="patient_gender" string="Patient Gender"/>
                            <field name="patient_ref" string="Patient Code"/>
                            <field name="date_day" string="Day"/>
                            <field name="user_level" widget="many2many_tags" options="{'color_field':'color'}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="html_field">
                            <group>
                                <field string="Html: " name="html_field"
                                       options="{'collaborative':true ,'resizable':true}"/>
                            </group>
                        </page>
                        <page string="medicine">
                            <group>
                                <field name="medicine_line_ids">
                                    <tree>
                                        <field name="product_id"/>
                                        <field name="product_price" column_invisible="parent.show_col"/>
                                        <field name="qty"/>
                                    </tree>
                                    <form>
                                        <group>
                                            <field name="product_id" string="Product Name"/>
                                            <field name="product_price"/>
                                            <field name="qty"/>
                                        </group>
                                    </form>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" group="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="appointment_action" model="ir.actions.act_window">
        <field name="name">patient appointment</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
            id="appointment_details"
            name="Patient Appointmnet"
            parent="appointment_id"
            action="appointment_action"
    />
</odoo>
<odoo>

    <record id="patient_tree_view" model="ir.ui.view">
        <field name="name">patient.tree</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" string="patient Name" decoration-bf="1" decoration-it="1" decoration-success="1"/>
                <field name="gender" string="patient Gender" decoration-danger="gender == 'female'" decoration-it="gender == 'female'" decoration-warning="gender == 'male'"/>
                <field name="ref"/>
                <field name="age" string="patient Age" avg="Average age" />
                 <field name="ref"/>
                <field name="appointment_count" string="Appointment Count" sum="Sum of appointment"/>
            </tree>
        </field>
    </record>

    <record id="hospital_form_view" model="ir.ui.view">
        <field name="name">hospital.patient</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="hello" type="object"  string="Say Hi" class="oe_highlight" confirm="Execute Python Code?" groups="base.group_no_one"/>
                    <button name="%(hospital_app.appointment_action)d" type="action"  string="Appointment" class="oe_highlight" confirm="Go to page ?" groups="base.group_no_one"/>
                    <button name="try_some" type="object" string="Try" class="oe_highlight"/>
                    <field  name="state" widget="statusbar" nolabel="1" options="{'clickable':1}" statusbar_visible="start,in_progress,draft,done" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="show_appointment" type="object" class="oe_stat_button" icon="fa-star">
                            <field string="Appointments" name="appointment_count" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="alert alert-info text-center o_form_header" role="alert" invisible="is_this_birth != True">
                        <a class="close float-end" data-bs-dismiss="alert" href="#">X</a>
                        <div>
                            <strong>Today is birthday !</strong>
                        </div>
                        <div>
                            wish <field name="name" readonly="1"/>
                        </div>
                    </div>
                    <field name="patient_image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="ref" readonly="1"/>
                        </h1>
                        <h2>
                            <label for="name" string="Name"  class="oe_edit_only"/>
                            <field name="name" />
                            <field name="is_this_birth" invisible="1"/>
                        </h2>
                        <h3>
                            <field name="priority" widget="priority"/>
                        </h3>
                    </div>
                    <group>
                        <group>
                            <field name="gender" string="Patient Gender: " invisible="context.get('hide_marker')" widget="radio"/>
                            <field name="birth_day" string="Date of Birth: "/>
                            <field name="appointment_count" string="Appointment Count"/>
                        </group>
                        <group>
                            <field name="age" string="Patient Age:"/>
                            <field name="code" string="Patient Code:"/>
                            <field name="active" string="Active" invisible='1'/>
                        </group>
                        <group string="Other Information">
                            <field name="parent_name" invisible="age > 18"/>
                            <field name="marital_status"/>
                            <field name="partner_name" required="marital_status == 'married'" readonly="marital_status == 'single'"/>
                        </group>
                        <group>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="url" widget="url"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="N and C">
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                            </group>
                        </page>
                        <page string="Gender">
                            <group>
                                <field name="gender"/>
                            </group>
                        </page>
                    </notebook>

                    <notebook>
                        <page string="Prescription">
                            <group>
                                <field name="prescription" placeholder="Enter Your Prescription"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" group="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>


    <record id="patient_search_view" model="ir.ui.view">
        <field name="name">search.paitent</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Patient Name"
                       filter_domain="['|',('name','ilike',self),('code','ilike',self)]"/>
                <field name="age" string="Patient Age"/>

                <filter name="archive" string="Archive" domain="[('active','=',False)]"/>

                <!--                <separator/>-->

                <!--                <filter name="filter_gender" string="Gender Male less that 40"-->
                <!--                        domain="['&amp;',('gender','=','male'),('age','&lt;=',40)]"/>-->
                <!--                <separator/>-->
                <!--                <filter name="filter_gender" string="Gender Female more than 30"-->
                <!--                        domain="['&amp;',('age','&gt;=',30),('gender','=','female')]"/>-->

                <!--                <group expand="0" string="group by">-->
                <!--                    <filter string="gender" name="group_by_gender" context="{'group_by':'gender'}"/>-->
                <!--                    <filter string="age" name="age" context="{'group_by':'age'}"/>-->
                <!--                </group>-->

                <searchpanel>
                    <field name="gender" select="multi" icon="fa-users" enable_counters="True"/>
                </searchpanel>

            </search>
        </field>

    </record>


    <record id="patient_details_window" model="ir.actions.act_window">
        <field name="name">patient details</field>
        <field name="res_model">hospital.patient</field>
        <field name="context">{'search_default_group_by_gender':1}</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
            id="child_menu"
            name="Patient Details"
            parent="second_menu"
            action="patient_details_window"
    />
</odoo>
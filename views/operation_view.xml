<odoo>

    <record id="operation_tree_view" model="ir.ui.view">
        <field name="name">Operation Tree</field>
        <field name="model">hospital.operation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="doctor_id"/>
                <field name="operation_name"/>
                <field name="reference_record"/>
            </tree>
        </field>
    </record>

    <record id="operation_form_view" model="ir.ui.view">
        <field name="name">Operation Form</field>
        <field name="model">hospital.operation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="doctor_id"/>
                        <field name="operation_name"/>
                        <field name="reference_record"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="operation_action" model="ir.actions.act_window">
        <field name="name">Doctor Operation</field>
        <field name="res_model">hospital.operation</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
            id="operation_menu"
            name="Operation"
            parent="configurations_menu"
            action="operation_action"
    />
</odoo>